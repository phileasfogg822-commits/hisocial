# Copy this file to .env and fill in your own values before running the app.
# NEVER commit the real .env file to GitHub.

APP_LOGIN_USERNAME=your_admin_username
APP_LOGIN_PASSWORD=your_admin_password
FRONTEND_URL=http://localhost:4001
REACT_APP_API_URL=http://localhost:4000
LOCAL_BACKEND_URL=http://backend:4000
PUBLIC_BACKEND_URL=
BACKEND_PORT=4000
FRONTEND_PORT=4001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=4001
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret_string
SESSION_SECRET=change_this_to_a_random_secret_string
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback
INSTAGRAM_CALLBACK_URL=http://localhost:4000/auth/instagram/callback
LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback
LINKEDIN_ORG_CALLBACK_URL=http://localhost:4000/auth/linkedin-org/callback
TWITTER_CALLBACK_URL=http://localhost:4000/auth/twitter/callback
REDDIT_CALLBACK_URL=http://localhost:4000/auth/reddit/callback
PINTEREST_CALLBACK_URL=http://localhost:4000/auth/pinterest/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
YOUTUBE_CALLBACK_URL=http://localhost:4000/auth/youtube/callback
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=<redacted>
TIKTOK_CALLBACK_URL=http://localhost:4000/auth/tiktok/callback
HOST_CHROME_DATA_PATH=./chrome_data
ALIBABA_DASHSCOPE_API_KEY=your_alibaba_dashscope_api_key
ALIBABA_REGION=singapore

# Phase 28: token encryption at rest (REQUIRED for storing
# social tokens and custom platform keys). Any long random
# string works — it is SHA-256 hashed to 32 bytes. Changing
# it orphans previously encrypted tokens: they will fail to
# decrypt and the accounts must be reconnected. Set it once
# at VPS migration and never change it casually.
ENCRYPTION_KEY=your_long_random_encryption_key_here
