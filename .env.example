# Copy this file to .env and fill in your own values before running the app.
# NEVER commit the real .env file to GitHub.

APP_LOGIN_USERNAME=your_admin_username
APP_LOGIN_PASSWORD=your_admin_password
FRONTEND_URL=http://localhost:4001
REACT_APP_API_URL=http://localhost:4000
LOCAL_BACKEND_URL=http://backend:4000
PUBLIC_BACKEND_URL=
BACKEND_PORT=4000
FRONTEND_PORT=4001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=4001
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret_string
SESSION_SECRET=change_this_to_a_random_secret_string
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback
INSTAGRAM_CALLBACK_URL=http://localhost:4000/auth/instagram/callback
LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback
LINKEDIN_ORG_CALLBACK_URL=http://localhost:4000/auth/linkedin-org/callback
TWITTER_CALLBACK_URL=http://localhost:4000/auth/twitter/callback
REDDIT_CALLBACK_URL=http://localhost:4000/auth/reddit/callback
PINTEREST_CALLBACK_URL=http://localhost:4000/auth/pinterest/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
YOUTUBE_CALLBACK_URL=http://localhost:4000/auth/youtube/callback
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=<redacted>
TIKTOK_CALLBACK_URL=http://localhost:4000/auth/tiktok/callback
HOST_CHROME_DATA_PATH=./chrome_data
ALIBABA_DASHSCOPE_API_KEY=your_alibaba_dashscope_api_key
ALIBABA_REGION=singapore

# Phase 28: token encryption at rest (REQUIRED for storing
# social tokens and custom platform keys). Any long random
# string works — it is SHA-256 hashed to 32 bytes. Changing
# it orphans previously encrypted tokens: they will fail to
# decrypt and the accounts must be reconnected. Set it once
# at VPS migration and never change it casually.
ENCRYPTION_KEY=your_long_random_encryption_key_here

# Phase 29: platform + AI + infra keys that the code
# reads but the original example did not list. Fill
# only the ones you actually connect; leave the rest
# empty. Never commit the filled-in file.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=<redacted>
FACEBOOK_ENABLE_PAGE_SCOPES=false
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=<redacted>
LINKEDIN_ORG_CLIENT_ID=your_linkedin_org_client_id
LINKEDIN_ORG_CLIENT_SECRET=<redacted>
LINKEDIN_ENABLE_ORG_SCOPES=false
LINKEDIN_COMPANY_ID=your_linkedin_company_id
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=<redacted>
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=<redacted>
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=<redacted>
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
BIGMODEL_API_KEY=your_bigmodel_key
DEAPI_API_KEY=your_deapi_key
GROK_API_KEY=your_grok_key
AI_PROVIDER=
MUSE_BRIDGE_TOKEN=your_muse_bridge_token
# Must match POSTGRES_PASSWORD in docker-compose.yml
# (the compose default); a wrong password here breaks
# the backend's database connection on every start.
DATABASE_URL=postgresql://socialhub:socialhub_secret@postgres:5432/socialhub
REDIS_URL=redis://redis:6379
PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
PUPPETEER_EXECUTABLE_PATH=
LINKEDIN_CHROME_PROFILE_DIRECTORY=
LINKEDIN_CHROME_PROFILE_PATH=
CLOUDFLARED_METRICS_HOST=cloudflared
CLOUDFLARED_METRICS_PORT=20000
MONITOR_ALLOW_PUBLIC_FALLBACK=false
MONITOR_SCAN_TIMEOUT_MS=30000
