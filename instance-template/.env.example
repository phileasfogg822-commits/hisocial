# HiSocial instance .env — TEMPLATE ONLY. Copy to .env, fill in, never commit.
# Generated .env files are created by scripts/new-instance.sh with fresh secrets.
# Placeholders below are intentionally not valid secrets: validate-instance.sh
# refuses any .env that still contains them.

# --- Instance identity (one per instance, never shared) ---
INSTANCE_SLUG=change_me_slug
INSTANCE_DOMAIN=change_me.example.com
COMPOSE_PROJECT_NAME=hisocial-change_me_slug

# --- Ports (index 0 = 4000/4001/5433/6380; index 1 = 4010/4011/5443/6390, ...) ---
BACKEND_PORT=4000
FRONTEND_PORT=4001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Public URLs (named tunnel, not a quick tunnel) ---
FRONTEND_URL=https://change_me.example.com
PUBLIC_BACKEND_URL=https://api.change_me.example.com
REACT_APP_API_URL=https://api.change_me.example.com

# --- App login (this instance only) ---
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=change_me_app_password

# --- Secrets (generated per instance by new-instance.sh; never reuse) ---
JWT_SECRET=change_me_jwt_secret
SESSION_SECRET=change_me_session_secret
POSTGRES_PASSWORD=change_me_postgres_password
MUSE_BRIDGE_TOKEN=change_me_muse_bridge_token

# --- Cloudflare named tunnel (manual owner step; see README.md) ---
CLOUDFLARED_TUNNEL_NAME=hisocial-change_me_slug
CLOUDFLARED_TUNNEL_ID=change_me_tunnel_id

# --- Social developer apps (one set per instance; paste from each developer portal) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.change_me.example.com/auth/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CALLBACK_URL=https://api.change_me.example.com/auth/instagram/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.change_me.example.com/auth/linkedin/callback
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
LINKEDIN_ORG_CALLBACK_URL=https://api.change_me.example.com/auth/linkedin-org/callback
LINKEDIN_COMPANY_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CALLBACK_URL=https://api.change_me.example.com/auth/twitter/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_CALLBACK_URL=https://api.change_me.example.com/auth/reddit/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_CALLBACK_URL=https://api.change_me.example.com/auth/pinterest/callback

# --- AI providers (optional; Muse bridge is separate and needs no API key here) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
BIGMODEL_API_KEY=
DEAPI_API_KEY=
ALIBABA_DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

NODE_ENV=production
